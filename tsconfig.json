{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2016",
    "jsx": "preserve",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true,
    "outDir": "../../build/test",
    "allowJs": true,
    "removeComments": true,
    "noImplicitAny": false,
  },
  "exclude": ["static"]
}
