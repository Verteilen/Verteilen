    "build:mac": "ts-node scripts/program_build.ts mac && ts-node scripts/build.ts && electron-builder --mac",
    "build:linux": "ts-node scripts/program_build.ts linux && ts-node scripts/build.ts && electron-builder --linux",
    "publish:node-pkg": "cd build/node-build && npm publish",
    "pkg": "ts-node scripts/program_build.ts",
    "test": "jest --coverage"
  },
