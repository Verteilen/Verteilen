{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "useDefineForClassFields": true,
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "../../build/main",
    "allowJs": true,
    "removeComments": true,
    "resolveJsonModule": true,
    "noImplicitAny": false,
    "types": ["@types/wicg-file-system-access"],
    "lib": ["esnext", "dom"]
  }
}
