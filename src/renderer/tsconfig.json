{
  "compilerOptions": {
    "target": "es2024",
    "useDefineForClassFields": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["@types/wicg-file-system-access", "vite-plugin-pwa/client", "vite-plugin-pwa/vue"],
    "lib": ["esnext", "dom"]
  },
  "include": ["./**/*.scss", "./**/*.ts", "./**/*.d.ts", "./**/*.tsx", "./**/*.vue", "./**/*.json", "components/components/code/Linter.js"],
}

